# App
APP_NAME=Layerora
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://layerora:secret@localhost:5432/layerora
# For SQLite dev: sqlite+aiosqlite:///./layerora.db

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 (Cloudflare R2 example)
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=layerora-dev
S3_REGION=auto
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# AI Providers
OPENAI_API_KEY=sk-...
GOOGLE_VISION_API_KEY=...
REPLICATE_API_TOKEN=...

# Security
JWT_SECRET=your-jwt-secret
AUTH_COOKIE_SECURE=False

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

WATERMARK_PATCH_SIZE=15
WATERMARK_SEARCH_RADIUS=80
WATERMARK_PATCH_ITERATIONS=2
WATERMARK_MASK_CLOSE_SIZE=3
WATERMARK_MASK_DILATE_SIZE=3
WATERMARK_BLEND_SIZE=5
WATERMARK_INPAINT_RADIUS=3